# Model provider for the Strands agents: bedrock (default) | anthropic (Claude API fallback)
CREDBRIDGE_PROVIDER=bedrock
AWS_REGION=us-west-2
# Model id. Its format follows the provider, so change it together with CREDBRIDGE_PROVIDER;
# Verified live 2026-09-13: us.anthropic.claude-sonnet-4-6 on Bedrock us-west-2 (7/7 eval).
# Claude 3.7 Sonnet is end-of-life on Bedrock; Sonnet 5 is not offered to every account.
#   bedrock   -> inference-profile id (list: aws bedrock list-inference-profiles --region us-west-2)
# CREDBRIDGE_MODEL=us.anthropic.claude-sonnet-4-6
#   anthropic -> Claude API id
# CREDBRIDGE_MODEL=claude-sonnet-5
# Optional: separate model id for the KB harvester (defaults to CREDBRIDGE_MODEL, same provider)
# CREDBRIDGE_HARVEST_MODEL=
# Required for the anthropic provider (the agent refuses to build without it). Never commit a real key.
# ANTHROPIC_API_KEY=
# Optional: pin "today" for a deterministic demo (expiry reasoning references this date)
# CREDBRIDGE_TODAY=2026-09-14
# All of the above is read when the agent is first built: set it before the first request.
# Bedrock credentials come from the AWS CLI profile (`aws configure` / `aws login`), never this file.
