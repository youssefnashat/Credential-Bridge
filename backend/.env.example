# Model provider for the Strands agents: bedrock (default) | anthropic (Claude API fallback)
CREDBRIDGE_PROVIDER=bedrock
AWS_REGION=us-west-2
# VERIFY before relying on it — no model id has passed a live call yet. Claude 3.7 Sonnet is
# end-of-life on Bedrock. The id format follows the provider:
#   bedrock   -> inference-profile id, e.g. us.anthropic.claude-sonnet-5
#                (list them: aws bedrock list-inference-profiles --region us-west-2)
#   anthropic -> Claude API id, e.g. claude-sonnet-5 (the default when CREDBRIDGE_MODEL is unset)
CREDBRIDGE_MODEL=us.anthropic.claude-sonnet-5
# Optional: separate model id for the KB harvester (defaults to CREDBRIDGE_MODEL, same provider)
# CREDBRIDGE_HARVEST_MODEL=
# anthropic provider only. Never commit a real key.
# ANTHROPIC_API_KEY=
# Optional: pin "today" for a deterministic demo (expiry reasoning references this date)
# CREDBRIDGE_TODAY=2026-09-14
# Bedrock credentials come from the AWS CLI profile (`aws configure` / `aws login`), never this file.
